<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.simulatorgui.controller.MainController" style="-fx-background-color: linear-gradient(to bottom, #f7f8fa, #eef1f5);">
    <center>
        <VBox spacing="16" alignment="TOP_CENTER" style="-fx-padding: 32 40;">
            <Label text="Car Race Simulator" styleClass="title-label"/>
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 14, 0, 0, 6);">
                <Label text="Currently steered car:" styleClass="title-grey-label"/>
                <ComboBox fx:id="storedCarsComboBox" promptText="Select car" prefWidth="240" styleClass="combobox"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="New car" onAction="#onNewCar" styleClass="btn, btn-blue-reverse"/>
                <Button text="Delete" onAction="#onDeleteCar" styleClass="btn, btn-red-reverse"/>
            </HBox>
            <HBox spacing="24" alignment="TOP_CENTER">
                <VBox spacing="10" style="-fx-background-color: #ffffff;-fx-padding: 24;-fx-background-radius: 16;-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 14, 0, 0, 6);">
                    <VBox fx:id="carContainer" spacing="12" />
                </VBox>
                <VBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 14, 0, 0, 6);">
                    <Label text="Race track" styleClass="title-grey-label"/>
                    <Label text="Manipulate selected cars." wrapText="true" styleClass="description-grey-label"/>
                    <Pane fx:id="raceTrackPane" VBox.vgrow="ALWAYS" prefHeight="220" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #dcdfe6; -fx-background-color: #fafafa;" />
                    <HBox spacing="12">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="startButton" text="Place start" styleClass="btn, btn-blue"/>
                        <Button fx:id="targetButton" text="Place finish" styleClass="btn, btn-grey"/>
                        <Button text="Clear" onAction="#onClearTrack" styleClass="btn, btn-grey-reverse"/>
                    </HBox>
                </VBox>
            </HBox>
            <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff;-fx-padding: 24;-fx-background-radius: 16;-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 14, 0, 0, 6);">
                <VBox fx:id="hudContainer" spacing="12" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
