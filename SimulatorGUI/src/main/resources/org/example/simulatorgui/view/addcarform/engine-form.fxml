<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.simulatorgui.controller.addcarform.EngineController"  spacing="16" style="
          -fx-padding: 24;
          -fx-background-color: #ffffff;
          -fx-background-radius: 16;
          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0.2, 0, 4);
      ">
    <Label text="Engine" styleClass="title-grey-label"/>
    <Separator opacity="0.3"/>
    <VBox spacing="12">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Name" styleClass="input-label"/>
            <TextField fx:id="engineNameTextField" promptText="Enter name" text="Engine" HBox.hgrow="ALWAYS" styleClass="textfield"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Price" styleClass="input-label"/>
            <TextField fx:id="enginePriceTextField" promptText="Enter price [PLN]" text="200000" HBox.hgrow="ALWAYS" styleClass="textfield"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Weight" styleClass="input-label"/>
            <TextField fx:id="engineWeightTextField" promptText="Enter weight [kg]" text="300" HBox.hgrow="ALWAYS" styleClass="textfield"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Max RPM" styleClass="input-label"/>
            <TextField fx:id="engineRPMTextField" promptText="Enter RPM" text="10000" HBox.hgrow="ALWAYS" styleClass="textfield"/>
        </HBox>
    </VBox>
    <Separator opacity="0.3"/>
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
        <Button text="Cancel" onAction="#onCancel" styleClass="btn, btn-cancel"/>
        <Button fx:id="confirmEngineButton" text="Confirm" onAction="#onConfirm" styleClass="btn, btn-confirm"/>
    </HBox>
</VBox>
