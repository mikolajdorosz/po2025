<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.simulatorgui.controller.competition.CarHUDController" spacing="16" style="-fx-padding: 14; -fx-background-color: #1e1e1e; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 14, 0, 0, 6);">
    <HBox spacing="16" alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_RIGHT" spacing="8" style="-fx-padding: 0 16">
            <Button text="Gear Down" fx:id="gearDownButton" onAction="#onGearDown" styleClass="btn, btn-orange" />
            <HBox spacing="8">
                <Button text="ON/OFF" fx:id="carIgnitionButton" onAction="#onCarIgnition" styleClass="btn, btn-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Button text="Clutch" fx:id="clutchButton" onAction="#onClutch" styleClass="btn, btn-grey" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </HBox>
        </VBox>
        <VBox alignment="CENTER" spacing="4">
            <Label text="RPM" styleClass="clock-label"/>
            <StackPane prefWidth="80" prefHeight="80" style="-fx-background-color: #2a2a2a; -fx-background-radius: 50%; -fx-border-radius: 50%; -fx-border-color: #4b5563; -fx-border-width: 3;">
                <Label fx:id="rpmLabel" text="6500" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            </StackPane>
        </VBox>
        <VBox alignment="CENTER" spacing="4">
            <Label text="Speed" styleClass="clock-label"/>
            <StackPane prefWidth="100" prefHeight="100" style="-fx-background-color: #2a2a2a; -fx-background-radius: 50%; -fx-border-radius: 50%; -fx-border-color: #4b5563; -fx-border-width: 3;">
                <Label fx:id="speedLabel" text="100" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            </StackPane>
        </VBox>
        <VBox alignment="CENTER" spacing="4">
            <Label text="Gear" styleClass="clock-label"/>
            <StackPane prefWidth="70" prefHeight="70" style="-fx-background-color: #2a2a2a; -fx-background-radius: 50%; -fx-border-radius: 50%; -fx-border-color: #4b5563; -fx-border-width: 3;">
                <Label fx:id="gearLabel" text="4" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            </StackPane>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_LEFT" spacing="8" style="-fx-padding: 0 16">
            <Button text="Gear Up" fx:id="gearUpButton" onAction="#onGearUp" styleClass="btn, btn-blue" />
            <HBox spacing="8">
                <Button text="Brake" fx:id="brakeButton" onAction="#onBrake" styleClass="btn, btn-orange" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Gas" fx:id="gasButton" onAction="#onGas" styleClass="btn, btn-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
