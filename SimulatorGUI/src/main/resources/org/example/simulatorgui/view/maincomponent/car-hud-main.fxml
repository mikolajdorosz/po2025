<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.simulatorgui.controller.maincomponent.CarHUDController" spacing="18" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 16, 0, 0, 6);">
    <HBox spacing="18" alignment="CENTER">
        <VBox alignment="BOTTOM_RIGHT" spacing="10" style="-fx-padding: 0 16">
            <Button text="Gear Down [K]" fx:id="gearDownButton" onMousePressed="#onGearDown" onMouseReleased="#onGearDownRelease" styleClass="btn, btn-orange"/>
            <HBox spacing="10">
                <Button text="ON / OFF [E]" fx:id="carIgnitionButton" onMousePressed="#onCarIgnition" styleClass="btn, btn-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Clutch [SHIFT]" fx:id="clutchButton" onMousePressed="#onClutch" styleClass="btn, btn-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
        <VBox alignment="CENTER" spacing="6">
            <Label text="RPM" style="-fx-font-size: 10px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <StackPane prefWidth="70" prefHeight="70" styleClass="clock-wrapper">
                <Label fx:id="rpmLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
            </StackPane>
        </VBox>
        <VBox alignment="CENTER" spacing="6">
            <Label text="SPEED" style="-fx-font-size: 10px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <StackPane prefWidth="90" prefHeight="90" styleClass="clock-wrapper, main-clock-wrapper">
                <Label fx:id="speedLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #2563eb;"/>
            </StackPane>
        </VBox>
        <VBox alignment="CENTER" spacing="6">
            <Label text="GEAR" style="-fx-font-size: 10px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <StackPane prefWidth="60" prefHeight="60" styleClass="clock-wrapper">
                <Label fx:id="gearLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
            </StackPane>
        </VBox>
        <VBox alignment="BOTTOM_LEFT" spacing="10" style="-fx-padding: 0 16">
            <Button text="Gear Up [L]" fx:id="gearUpButton" onMousePressed="#onGearUp" onMouseReleased="#onGearUpRelease" styleClass="btn, btn-blue"/>
            <HBox spacing="10">
                <Button text="Brake [S]" fx:id="brakeButton" onMousePressed="#onBrake" onMouseReleased="#onBrakeRelease" styleClass="btn, btn-orange" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Gas [W]" fx:id="gasButton" onMousePressed="#onGas" onMouseReleased="#onGasRelease" styleClass="btn, btn-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
