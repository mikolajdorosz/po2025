<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.simulatorgui.controller.maincomponent.TopbarController" alignment="CENTER">
    <Label text="Competitors" styleClass="title-grey-label" prefWidth="220" style="-fx-padding: 8 16; -fx-background-color: rgba(248,249,251, .85); -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 6);" />
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="stopwatchLabel" text="1:00:00" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827; -fx-padding: 8 16; -fx-background-color: rgba(248,249,251, .85); -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 6);"/>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox spacing="8" prefWidth="220" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 6);" >
        <Button text="Pause" fx:id="pauseButton" onAction="#onPause" styleClass="btn, btn-blue"/>
        <Button text="Restart" fx:id="restartButton" onAction="#onRestart" styleClass="btn, btn-blue-reverse"/>
        <Button text="Exit" fx:id="exitButton" onAction="#onExit" styleClass="btn, btn-red-reverse"/>
    </HBox>
</HBox>
