<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.simulatorgui.controller.addcarform.ClutchController" spacing="16" style="
        -fx-background-color: #ffffff;
        -fx-padding: 24;
        -fx-background-radius: 16;
        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0.2, 0, 4);
    ">
    <Label text="Clutch" styleClass="title-grey-label"/>
    <Separator opacity="0.3" prefWidth="320"/>
    <VBox spacing="12">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Name" styleClass="input-label" />
            <TextField fx:id="clutchNameTextField" promptText="Enter name" text="Clutch" HBox.hgrow="ALWAYS" styleClass="textfield" />
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Price" styleClass="input-label" />
            <TextField fx:id="clutchPriceTextField" promptText="Enter price [PLN]" text="10000" HBox.hgrow="ALWAYS" styleClass="textfield" />
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Weight" styleClass="input-label" />
            <TextField fx:id="clutchWeightTextField" promptText="Enter weight [kg]" text="50" HBox.hgrow="ALWAYS" styleClass="textfield" />
        </HBox>
    </VBox>
    <Separator opacity="0.3" prefWidth="320"/>
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 12 0 0 0;">
        <Button text="Cancel" onAction="#onCancel" styleClass="btn, btn-cancel"/>
        <Button text="Confirm" onAction="#onConfirm" styleClass="btn, btn-confirm"/>
    </HBox>
</VBox>
